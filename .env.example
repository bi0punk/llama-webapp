# Configuración de Llama Control Center
# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# Las variables se cargan automáticamente desde `.env` al iniciar la app
# (las variables ya exportadas en el entorno tienen prioridad).

# --- Datos y almacenamiento ---
# DATA_DIR es el directorio donde se guardan logs, modelos y la base SQLite.
DATA_DIR=/srv/llama-control-center/data
# DATABASE_URL=sqlite:////srv/llama-control-center/data/app.db

# --- Cola de trabajos (Redis/RQ) ---
# Redis se usa para las descargas de modelos en background.
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PASSWORD=

# --- Modelos ---
DEFAULT_MODELS_DIR=/srv/llama-control-center/models
# Rutas adicionales separadas por ":" para buscar binarios de llama.cpp y modelos GGUF
# LLAMA_SEARCH_PATHS=/opt/llama/bin:/usr/local/bin
# MODEL_SCAN_PATHS=/srv/models:/app/models

# --- Binarios de llama.cpp ---
# LLAMA_SERVER_BIN=/opt/llama/bin/llama-server
# LLAMA_RUN_BIN=/opt/llama/bin/llama-run
# LLAMA_CLI_BIN=/opt/llama/bin/llama-cli

# --- Servidor llama-server por defecto ---
DEFAULT_SERVER_HOST=127.0.0.1
DEFAULT_SERVER_PORT=8081
DEFAULT_SERVER_ALIAS=llama-local
DEFAULT_CTX_SIZE=4096
DEFAULT_THREADS=4
DEFAULT_N_GPU_LAYERS=0

# --- Red / web ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# DEFAULT_PUBLIC_HOST=192.168.1.25
# DEFAULT_PUBLIC_PORT=8081
# WEB_TITLE=Llama Control Center
# Token opcional para proteger la web. Si se define, se exige login con este token.
# LLAMA_WEB_TOKEN=cambia_este_token

# --- Hugging Face (para modelos con acceso restringido) ---
# HUGGING_FACE_TOKEN=hf_your_token_here