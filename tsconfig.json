{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "app/static/js",
    "rootDir": "app/static/ts",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["app/static/ts/**/*.ts"]
}
