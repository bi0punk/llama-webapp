# Data directory
DATA_DIR=/opt/llm-control-center/data

# Redis (sin password para local, añadir REDIS_PASSWORD si aplica)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Hugging Face token (opcional, para modelos gated/privados)
HUGGING_FACE_TOKEN=

# Rutas extra de búsqueda de binarios (separadas por :)
# LLAMA_SEARCH_PATHS=/opt/llama/bin:/home/user/llama.cpp/build/bin

# Rutas extra de escaneo de modelos (separadas por :)
# MODEL_SCAN_PATHS=/mnt/models:/data/models

# SQLite pool (opcional, defaults: pool=5, timeout=15, overflow=10)
# SQLITE_POOL_SIZE=5
# SQLITE_POOL_TIMEOUT=15
# SQLITE_MAX_OVERFLOW=10
